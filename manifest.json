{
  "manifest_version": 3,
  "name": "PromptForge — AI Prompt Enhancer",
  "short_name": "PromptForge",
  "version": "1.0.1",
  "description": "Transform weak prompts into expert-level instructions instantly. Get dramatically better answers from ChatGPT with one click.",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon48.png",
    "default_title": "PromptForge"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://api.promptforge.website/*",
    "https://*.supabase.co/*"
  ]
}